%% Behavior authority: README.md (Checks table and check contracts) and internal/cli/sources.go (the eight registered sources), internal/runner/*, internal/gohost, internal/gate/gate.go (testRunners, narrow).
%% Discovery reads Git-tracked files only; test names must be static, and what ytif cannot list exactly fails discovery.
%% Function signatures, provided values and per-runner unit/name live in README.md (Checks).
flowchart LR
  subgraph Test["Six test runners · eligible for --base narrowing"]
    GoTest["go-test<br/><small>TestXxx · FuzzXxx · examples with output</small>"]
    BunTest["bun-test<br/><small>*.test.* importing bun:test</small>"]
    NodeTest["node-test<br/><small>*.test.* importing node:test</small>"]
    Dotnet["dotnet-test<br/><small>.csproj referencing Microsoft.NET.Test.Sdk</small>"]
    Vitest["vitest-test<br/><small>vitest list output</small>"]
    Playwright["playwright-test<br/><small>playwright test --list output</small>"]
  end
  subgraph Verify["Two verify runners · never narrowed"]
    GoVerify["go-verify<br/><small>VerifyXxx in //go:build verification files</small>"]
    NodeVerify["node-verify<br/><small>exported verifyXxx in *.verify.mjs</small>"]
  end
  Key["Check key = runner:unit:name<br/><small>• unit: package · file · .csproj<br/>• name: function · suite &gt; test</small>"]
  JsBin["Run through project node_modules/.bin<br/><small>requires dependencies and builds to be ready</small>"]
  Findings["finding: path:line: message<br/><small>failure: Go error return · Node throw</small>"]
  Test -.- Key
  Verify -.- Key
  Vitest -.- JsBin
  Playwright -.- JsBin
  Verify -.- Findings
