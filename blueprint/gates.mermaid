%% Behavior authority: internal/gate/gate.go (Run), internal/gate/survey.go, internal/gate/plans.go and README.md (Gates).
%% dinyd: internal/gate/gate.go#Run s1:f7690a3f1e794db6
%% Invalid input exits before record creation. Admission findings reconcile and finish as an incomplete failed attempt, recorded when enabled.
%% The mandatory gate policy plans every member; narrowing that cannot be resolved widens to full with a reason. A valid empty selection skips without fallback.
%% list uses complete discovery separately. A gate run activates only sources owning runnable selections; effective-full CI activates every source.
%% dinyd: internal/gate/survey.go#NewSurvey s1:687bd091fdb64691
flowchart TB
  Input["Validate configuration and revisions<br/><small>Admission runs before project execution</small>"]
  Invalid["Report input or load error<br/><small>No records are written</small>"]
  Rejected["Reconcile admission findings<br/><small>No Nx, preparation, discovery or execution</small>"]
  Members["Gate members<br/><small>• check and commit opt in independently<br/>• push includes all except skip-push<br/>• CI includes all verifications</small>"]
  %% dinyd: internal/inventory/inventory.go#Entry.Member s1:b9c171c2f6703344
  Plans["Per-key plans from the mandatory policy<br/><small>• Most specific scope wins; full keeps the registered invocation</small>"]
  Outcomes["Resolve each plan against the comparison<br/><small>• Run full, run narrowed, or skip<br/>• Unresolvable narrowing widens to full with a reason</small>"]
  Census{"Effective-full CI?<br/><small>Every plan runs full</small>"}
  All["Activate every source<br/><small>Complete discovery, including unregistered work</small>"]
  Selected["Activate selected sources<br/><small>Inactive sources are not judged missing or stale</small>"]
  Discover["Prepare and discover<br/><small>Only active sources need preparation</small>"]
  %% dinyd: internal/gate/survey.go#Survey.prepare s1:06d49989583edac2
  %% dinyd: internal/gate/survey.go#Survey.discover s1:7acebb91411823be
  Reconcile["Reconcile and restore co-runs<br/><small>Required partners must share gate membership</small>"]
  %% dinyd: internal/gate/gate.go#closeCoRuns s1:0d6266841e3d3efc
  %% dinyd: internal/gate/survey.go#Survey.placementOrder s1:b5ab8cad6cf0cc71
  Run["Execute runnable selections<br/><small>Shared process limit and command-exclusive tokens</small>"]
  %% dinyd: internal/proc/proc.go#Run s1:2705dd6f8623d0d8
  %% dinyd: internal/checkrun/checkrun.go#Source.execute s1:86e3034971840243
  Finish["Aggregate verdict and record when enabled<br/><small>Keep outcomes distinct from selection and omission</small>"]

  Input -->|Invalid input or load failure| Invalid
  Input -->|Admission rejected| Rejected
  Rejected -->|Incomplete failed attempt| Finish
  Input -->|Admitted| Members
  Members --> Plans
  Plans --> Outcomes
  Outcomes --> Census
  Census -->|Yes| All
  Census -->|No| Selected
  All --> Discover
  Selected --> Discover
  Discover --> Reconcile --> Run --> Finish

  classDef em fill:#173d25,stroke:#86efac
  class Plans,Census em
