title: ytif · gate selection and execution
config:
  look: handDrawn
  handDrawnSeed: 5
  theme: dark
  themeVariables:
    mainBkg: "#333333"
    clusterBkg: "#242424"
  themeCSS: |
    small { display: inline-block; text-align: left; }
